# Copy to .env for local development: cp .env.example .env
DATABASE_URL=sqlite://arise_shine.db

# Language when the user has not picked one: en or sw.
# Unset: English in debug builds, Swahili in release builds.
DEFAULT_LANG=en

# First ASE administrator, created on startup if the phone number is new.
# Development test values only.
ADMIN_PHONE=0700000000
ADMIN_PIN=1234
ADMIN_NAME="Dev admin"

# Demo group "Amka Kumekucha". Logins with PIN 1234:
#   leader 0700000001, member 0700000002
SEED_DEMO=1

# Set to 1 when served over HTTPS.
COOKIE_SECURE=0

# Production only (docker compose reads .env.production):
# LITESTREAM_REPLICA_URL=s3://bucket-name/arise_shine.db
# LITESTREAM_ACCESS_KEY_ID=...
# LITESTREAM_SECRET_ACCESS_KEY=...
